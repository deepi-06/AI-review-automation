# Copy this file to ".env" and fill in your own values. NEVER commit .env.

# ---------- Admin login ----------
ADMIN_PASSWORD=choose-a-strong-password

# ---------- AI providers (at least one key is needed for real AI) ----------
# Primary provider: gemini or openai. The other one is used automatically as fallback.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# If both APIs fail (or no keys), use the built-in rule-based engine so the demo never breaks.
# Set to false to force real AI only.
ALLOW_OFFLINE_FALLBACK=true

# ---------- Gmail SMTP ----------
# Use a Gmail "App Password" (Google Account > Security > 2-Step Verification > App passwords)
SMTP_USER=your.address@gmail.com
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM_NAME=AI Review Automation System

# ---------- Google Calendar / Meet ----------
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ---------- App behaviour ----------
APP_URL=http://localhost:8501
TIMEZONE=Asia/Kolkata
TASK_DAYS=3
REVIEW_HOUR=11
MEETING_MINUTES=30
REMINDER_HOURS=24
REMINDER_CHECK_MINUTES=30
